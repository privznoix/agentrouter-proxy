# AgentRouter proxy configuration.
# Copy to ~/.agentrouter-proxy/.env (or a .env in your working directory)
# and fill in your key.

# REQUIRED: AgentRouter upstream API key
AGENTROUTER_API_KEY=

# Local proxy bearer token (default: local-agentrouter)
#AGENTROUTER_PROXY_API_KEY=local-agentrouter

# Upstream base URL (default: https://agentrouter.org/v1)
#AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# Upstream User-Agent (default: codex_cli_rs/1.0.0 (Windows; x86_64))
#AGENTROUTER_USER_AGENT=codex_cli_rs/1.0.0 (Windows; x86_64)

# Listen address used by the launcher (default: 127.0.0.1 / 4020)
#AGENTROUTER_PROXY_HOST=127.0.0.1
#AGENTROUTER_PROXY_PORT=4020

# Debug logging (default: true)
#AGENTROUTER_DEBUG=true

# Moderation resilience
#AGENTROUTER_COMPRESS_TOOL_OUTPUT=true
#AGENTROUTER_STRIP_IMAGES=auto
#AGENTROUTER_DROP_REASONING_EFFORT=auto
#AGENTROUTER_ALT_USER_AGENT=opencode/1.0.0
#AGENTROUTER_SANITIZE_MODERATION=auto
#AGENTROUTER_TRANSLATE_CONTENT_BLOCKED=auto
#AGENTROUTER_CAPTURE_MODERATION=true
#AGENTROUTER_MODELS_CACHE_TTL=300
